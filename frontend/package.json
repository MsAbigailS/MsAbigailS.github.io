{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"dev:vite": "bun --bun vite",
		"knip": "knip --include-entry-exports --include-subpath-exports --include nsExports,nsTypes --treat-config-hints-as-errors --treat-tag-hints-as-errors",
		"start": "NODE_ENV=production bun src/index.ts",
		"lint": "biome check --error-on-warnings --diagnostic-level=warn",
		"build": "bun run build.ts",
		"build:vite": "bun --bun vite build",
		"preview:vite": "bun --bun vite preview",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@gsap/react": "^2.1.2",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"gsap": "^3.13.0",
		"lucide-react": "^1",
		"react": "^19",
		"react-dom": "^19",
		"shadcn": "^4.23.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "latest",
		"@types/node": "^26.6.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.3.0",
		"knip": "^6.48.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^7.0.2",
		"vite": "^8.3.8"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
