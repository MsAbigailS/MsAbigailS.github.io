{
	"name": "bun-react-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"dev:vite": "bun --bun vite",
		"knip": "knip --include-entry-exports --include-subpath-exports --include nsExports,nsTypes --treat-config-hints-as-errors --treat-tag-hints-as-errors",
		"start": "NODE_ENV=production bun src/index.ts",
		"lint": "biome check --error-on-warnings --diagnostic-level=warn",
		"build": "bun run build.ts",
		"build:vite": "bun --bun vite build",
		"preview:vite": "bun --bun vite preview",
		"typecheck": "bun check",
		"test": "bun --bun vitest run --project storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@gsap/react": "^2.1.2",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"gsap": "^3.13.0",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.78.0",
		"react": "^19",
		"react-dom": "^19",
		"shadcn": "^4.23.1",
		"three": "^0.180.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@chromatic-com/storybook": "latest",
		"@storybook/addon-a11y": "10.6.9",
		"@storybook/addon-docs": "10.6.9",
		"@storybook/addon-onboarding": "10.6.9",
		"@storybook/addon-vitest": "10.6.9",
		"@storybook/react-vite": "10.6.9",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "latest",
		"@types/node": "^26.6.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/three": "^0.180.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/browser-playwright": "latest",
		"@vitest/coverage-v8": "latest",
		"knip": "^6.48.0",
		"playwright": "latest",
		"storybook": "10.6.9",
		"tailwindcss": "^4.1.11",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "latest"
	},
	"peerDependencies": {
		"typescript": "^7"
	}
}
